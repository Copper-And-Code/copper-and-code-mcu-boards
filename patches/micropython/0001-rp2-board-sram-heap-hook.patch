rp2: let a board keep part of the SRAM heap (MICROPY_BOARD_SRAM_HEAP).
Called once before gc_init with the SRAM heap bounds and the PSRAM size; the
default does nothing. modules/rgbpanel keeps a 480x480 framebuffer there when PSRAM
takes the heap (a DMA reading PSRAM holds up the panel DMA; SRAM does not).

diff --git a/ports/rp2/main.c b/ports/rp2/main.c
index f43c85e..f12358b 100644
--- a/ports/rp2/main.c
+++ b/ports/rp2/main.c
@@ -147,23 +147,35 @@ int main(int argc, char **argv) {
     // Initialise stack extents and GC heap.
     mp_cstack_init_with_top(&__StackTop, &__StackTop - &__StackBottom);
 
+    size_t psram_size = 0;
+    #if MICROPY_HW_ENABLE_PSRAM
+    psram_size = psram_get_size(); // 0 if PSRAM was not brought up
+    #endif
+    // A board may keep part of the SRAM heap for itself (it can be left empty when
+    // PSRAM takes the heap).
+    uint8_t *sram_heap_start = &__GcHeapStart;
+    uint8_t *sram_heap_end = &__GcHeapEnd;
+    MICROPY_BOARD_SRAM_HEAP(&sram_heap_start, &sram_heap_end, psram_size);
     #if MICROPY_HW_ENABLE_PSRAM
-    size_t psram_size = psram_get_size(); // 0 if PSRAM was not brought up
     if (psram_size) {
         // Use PSRAM from the end of any __in_psram data up to the top of the chip.
         void *psram_heap_start = &__psram_end__;
         void *psram_heap_end = &__psram_start__ + psram_size;
         #if MICROPY_GC_SPLIT_HEAP
-        gc_init(&__GcHeapStart, &__GcHeapEnd);
-        gc_add(psram_heap_start, psram_heap_end);
+        if (sram_heap_end > sram_heap_start) {
+            gc_init(sram_heap_start, sram_heap_end);
+            gc_add(psram_heap_start, psram_heap_end);
+        } else {
+            gc_init(psram_heap_start, psram_heap_end);
+        }
         #else
         gc_init(psram_heap_start, psram_heap_end);
         #endif
     } else {
-        gc_init(&__GcHeapStart, &__GcHeapEnd);
+        gc_init(sram_heap_start, sram_heap_end);
     }
     #else
-    gc_init(&__GcHeapStart, &__GcHeapEnd);
+    gc_init(sram_heap_start, sram_heap_end);
     #endif
 
     #if MICROPY_PY_LWIP
diff --git a/ports/rp2/mpconfigport.h b/ports/rp2/mpconfigport.h
index 3084531..2def6c9 100644
--- a/ports/rp2/mpconfigport.h
+++ b/ports/rp2/mpconfigport.h
@@ -315,6 +315,14 @@ extern void lwip_poll_hook(void);
 #define MICROPY_PY_BLUETOOTH_EXIT (void)atomic_state;
 #endif
 
+// Called once at boot before the GC heap is set up, with the SRAM heap bounds
+// (uint8_t **start, uint8_t **end) and the PSRAM size (0 without PSRAM): a board may
+// move the bounds to keep part of that SRAM for itself, or leave it empty when PSRAM
+// takes the heap.
+#ifndef MICROPY_BOARD_SRAM_HEAP
+#define MICROPY_BOARD_SRAM_HEAP(start, end, psram_size)
+#endif
+
 #ifndef MICROPY_BOARD_STARTUP
 #define MICROPY_BOARD_STARTUP()
 #endif
